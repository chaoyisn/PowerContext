{
  "name": "edgeseek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "p0:database": "node scripts/p0-database.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
