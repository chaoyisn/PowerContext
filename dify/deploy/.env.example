# Dify × OceanBase — 《记仇小镇：NPC 的复仇日记》部署配置模板
#
# 本文件只含占位值与本地开发默认值，**不含任何真实密钥**。
# 复制为 .env 后按需修改；.env 不要提交进仓库。
#
#   cp deploy/.env.example deploy/.env
#
# 所有变量都可被同名环境变量覆盖。

# ---------------------------------------------------------------- 通用
SECRET_KEY=change-me-to-a-random-64-char-string
INIT_PASSWORD=
CONSOLE_API_URL=
CONSOLE_WEB_URL=
APP_API_URL=
APP_WEB_URL=
SERVICE_API_URL=
FILES_URL=
LANG=zh_Hans.UTF-8
LC_ALL=zh_Hans.UTF-8
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Dify 自身数据库
# Dify 自身用 PostgreSQL；游戏数据在 seekdb，两者互不干扰。
POSTGRES_USER=dify
POSTGRES_PASSWORD=dify_local_only_2026
POSTGRES_DB=dify
REDIS_PASSWORD=dify_local_only_2026
CELERY_BROKER_URL=redis://:dify_local_only_2026@redis:6379/1
DB_PASSWORD=dify_local_only_2026

# ---------------------------------------------------------------- 模型接入
# 使用 Anthropic 兼容端点（本地 MiniMax 代理）。Dify 的 Anthropic 插件
# 走 /v1/messages，与该代理的协议一致。
# 注意：host.docker.internal 表示"从容器访问宿主机"。
ANTHROPIC_API_BASE_URL=http://host.docker.internal:15721
ANTHROPIC_API_KEY=PROXY_MANAGED
ANTHROPIC_MODEL=MiniMax-M3.1-Flash

# ---------------------------------------------------------------- 游戏后端
# Dify 的 HTTP Request 节点通过 ssrf_proxy 访问后端；
# 后端容器名/端口在 compose 中固定为 town-backend:8848。
TOWN_BACKEND_URL=http://town-backend:8848

# 后端服务凭据。**必填**。
#
# V2 起，游戏后端的**所有**业务接口都要求请求头 X-Town-Token
# 与此值一致，否则一律 401 —— 没有"留空即不校验"这回事了。
#
# Dify 通过**密钥型环境变量** {{#env.TOWN_BACKEND_TOKEN#}} 注入这个值，
# 密钥型变量在导出 DSL 时值会被清空，所以凭据不会进仓库。
#
# 怎么生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# ⚠️ 真实值只写进 deploy/.env（已 gitignore），不要提交。
TOWN_BACKEND_TOKEN=change-me-to-a-random-token

# 允许不带玩家身份访问（demo 模式）。打开后**不具备玩家身份隔离**：
# 任何带着正确服务凭据的调用方都能读写任意 player_id 的存档，
# 只有服务凭据在把关。
#
# 默认关闭。打开时后端的每个响应都会如实带上 demo_mode: true ——
# 那样就不能声称"已认证的玩家身份隔离"了。
TOWN_ALLOW_ANONYMOUS=0

# 验收脚本绑定的玩家身份（不是秘密，只是"谁在玩"）。
# 真正被验证的是"换个身份读别人存档会被拒"，而不是这个值本身保密。
TOWN_TEST_IDENTITY=verify_suite

# ---------------------------------------------------------------- seekdb (OceanBase)
# 游戏状态库。宿主机直连用 127.0.0.1:2881；从容器访问用 host.docker.internal:2881。
SDD_SEEKDB_HOST=127.0.0.1
SDD_SEEKDB_PORT=2881
SDD_SEEKDB_USER=root
SDD_SEEKDB_PASSWORD=
SDD_SEEKDB_DATABASE=memory_town

# ---------------------------------------------------------------- PowerContext
# 任务记忆服务端。由 scripts/start_powercontext.py 启动。
SDD_POWERCONTEXT_URL=http://127.0.0.1:8800
SDD_POWERCONTEXT_TOKEN=
SDD_POWERCONTEXT_TIMEOUT=20

# ---------------------------------------------------------------- 暴露端口
EXPOSE_NGINX_PORT=80
EXPOSE_API_PORT=5001
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
