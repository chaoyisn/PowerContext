# ---------- ResearchFlow ----------
# Copy to `.env` and fill in. Never commit a filled-in `.env`.

# --- seekdb (vector + full-text evidence store) ---
# Embedded mode (pylibseekdb) is Linux/macOS only; on Windows use the running server.
RF_SEEKDB_MODE=server
RF_SEEKDB_HOST=127.0.0.1
RF_SEEKDB_PORT=2881
RF_SEEKDB_TENANT=sys
RF_SEEKDB_USER=root
RF_SEEKDB_PASSWORD=
RF_SEEKDB_DATABASE=test
# Prefix applied to every table/collection ResearchFlow creates. Keeps other
# projects sharing this seekdb instance untouched.
RF_SEEKDB_PREFIX=rf_
# Full-text analyzer: ik | ngram | ngram2 | space | beng
RF_SEEKDB_FTS_ANALYZER=ik
# Vector index distance: cosine | l2 | inner_product
RF_SEEKDB_VECTOR_DISTANCE=cosine

# --- Embedding provider ---
# minilm  : pyseekdb built-in all-MiniLM-L6-v2 ONNX, 384-d (downloads ~86MB once)
# hashing : deterministic offline char-n-gram hashing, 384-d, zero download
# openai  : any OpenAI-compatible /embeddings endpoint
RF_EMBEDDING_PROVIDER=minilm
RF_EMBEDDING_DIMENSION=384
RF_EMBEDDING_MODEL=
RF_EMBEDDING_BASE_URL=
RF_EMBEDDING_API_KEY=

# --- PowerContext (long-term research task memory) ---
RF_POWERCONTEXT_URL=http://127.0.0.1:17429
RF_POWERCONTEXT_TOKEN=
RF_POWERCONTEXT_TIMEOUT=20
# Scope binding identity used to map a ResearchFlow project onto a PowerContext scope.
RF_POWERCONTEXT_INTEGRATION=researchflow
RF_POWERCONTEXT_MAX_CONTEXT_BYTES=6000

# --- LLM (OpenAI-compatible) ---
# Leave RF_LLM_API_KEY empty to run in the clearly-labelled "retrieval-only" mode.
RF_LLM_BASE_URL=https://api.deepseek.com
RF_LLM_MODEL=deepseek-chat
RF_LLM_API_KEY=
RF_LLM_TIMEOUT=60
RF_LLM_MAX_TOKENS=1200
RF_LLM_TEMPERATURE=0.2

# --- Retrieval / QA defaults ---
RF_RETRIEVAL_TOP_K=8
RF_RETRIEVAL_MIN_SCORE=0.0
# Evidence gate: a hit must literally cover this fraction of the query's discriminative
# tokens, otherwise it is not offered to the LLM as evidence (acceptance test T3).
# 0.30 comes from a measured margin on the demo corpus: answerable questions score
# 0.67-1.00, unanswerable ones 0.00-0.14.
RF_RETRIEVAL_MIN_COVERAGE=0.30
# Pure-vector mode may also qualify a hit on cosine similarity alone (paraphrase case).
RF_RETRIEVAL_VECTOR_CONFIDENCE=0.62
RF_QA_MAX_EVIDENCE_CHUNKS=8

# --- Upload limits ---
RF_UPLOAD_MAX_BYTES=20971520
RF_UPLOAD_ALLOWED_EXTENSIONS=.pdf,.md,.markdown,.txt

# --- HTTP API ---
RF_API_HOST=127.0.0.1
RF_API_PORT=8787
RF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
RF_DATA_DIR=./data
RF_LOG_DIR=./logs
RF_LOG_LEVEL=INFO
