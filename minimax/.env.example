# MiniMax SDD 上下文管理模块 — 配置模板
#
# 用法：复制为 .env 或直接导出到环境变量。
#   cp minimax/.env.example .env
#   set -a && . ./.env && set +a
#
# 本文件不包含任何真实密钥。请自行填写并确保 .env 不被提交。

# ---------------------------------------------------------------- 寻址路径
# 模块根目录（含 specs/ sample/ tests/）
SDD_CONTEXT_ROOT=./minimax

# ---------------------------------------------------------------- seekdb
SDD_SEEKDB_HOST=127.0.0.1
SDD_SEEKDB_PORT=2881
SDD_SEEKDB_USER=root
# 留空表示无密码；本地 seekdb 容器默认口令见 README 3.2
SDD_SEEKDB_PASSWORD=
# 库名。复现验证时用独立库名可与既有数据完全隔离
SDD_SEEKDB_DATABASE=sdd_context

# ---------------------------------------------------------------- PowerContext
SDD_POWERCONTEXT_URL=http://127.0.0.1:8790
SDD_POWERCONTEXT_TOKEN=
SDD_POWERCONTEXT_TIMEOUT=30
# 留空则自动使用服务器默认 scope
SDD_POWERCONTEXT_SCOPE_ID=

# ---------------------------------------------------------------- MiniMax
# Anthropic 兼容的 /v1/messages 端点
SDD_MINIMAX_BASE_URL=http://127.0.0.1:15721
# 真实密钥请通过环境变量或密钥管理器注入，勿写入仓库
SDD_MINIMAX_API_KEY=PROXY_MANAGED
SDD_MINIMAX_MODEL=MiniMax-M3.1-Flash
SDD_MINIMAX_TIMEOUT=600
